generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  forums   Forum[]
  comments Comment[]
}

model Forum {
  id          String    @id @default(uuid())
  title       String
  description String
  tags        String[]
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  comments    Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  forumId   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  forum     Forum    @relation(fields: [forumId], references: [id])
}
